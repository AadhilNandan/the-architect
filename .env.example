# THE ARCHITECT — Environment Configuration Example
# Copy this file to .env.local for local testing or configure these in Vercel Environment Variables.

# Required: Your Resend API Key (starts with 're_')
RESEND_API_KEY=

# Required: The destination email address where inscribed petitions should be received
CONTACT_EMAIL=

# Optional: Verified sender domain email. Defaults to 'The Architect <onboarding@resend.dev>' if not set.
# When using onboarding@resend.dev, the destination CONTACT_EMAIL must be the email associated with your Resend account.
# To send to any recipient, verify your domain in Resend and specify your custom sender here:
# RESEND_FROM_EMAIL=The Architect <contact@yourdomain.com>
